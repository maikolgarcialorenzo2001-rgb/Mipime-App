{
  "name": "mipime-cuentas",
  "version": "0.1.19-beta",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/sync-version.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "sync:version": "node scripts/sync-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "electron:ts": "tsc -p electron/tsconfig.json",
    "electron:rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "electron:start": "tsc -p electron/tsconfig.json && electron dist-electron/main.js",
    "electron:build": "ng build && tsc -p electron/tsconfig.json",
    "electron:build:win": "ng build && tsc -p electron/tsconfig.json && electron-builder --win",
    "electron:build:mac": "ng build && tsc -p electron/tsconfig.json && electron-builder --mac",
    "electron:build:linux": "ng build && tsc -p electron/tsconfig.json && electron-builder --linux",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:build:android": "ng build && npx cap sync android",
    "test": "ng test",
    "test:electron": "vitest run --config vitest.electron.config.ts",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "21.2.15",
    "@angular/router": "^21.2.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "better-sqlite3": "^13.0.2",
    "electron-updater": "^6.8.9",
    "material-symbols": "^0.45.3",
    "rxjs": "~7.8.0",
    "sqlocal": "^0.18.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.4.2",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.4.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
